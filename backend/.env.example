# Server Port (Render sets this dynamically)
PORT=5000

# Environment Mode
NODE_ENV=production

# Optional: MongoDB URI (If using MongoDB Atlas instead of local JSON datastore)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fraudshield

# Optional: AI API Keys for Advanced Cloud LLM (Gemini / OpenAI)
# GEMINI_API_KEY=your_gemini_api_key_here
